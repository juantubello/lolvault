{
  "name": "lolvault",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "predev": "npm run db:migrate",
    "build": "next build --webpack",
    "start": "next start",
    "prestart": "npm run db:migrate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx src/db/migrate.ts",
    "draft:sync": "node --import tsx src/features/draft/sync-cli.ts",
    "vapid:generate": "node scripts/generate-vapid.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.10",
    "lucide-react": "0.542.0",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
