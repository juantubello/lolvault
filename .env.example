# ── Server (homelab): copiar a .env y completar. .env está gitignoreado. ──
# AUD tag de la app de Access `lolvault` (obligatorio en el server).
LOLVAULT_ACCESS_AUD=
# Puerto del host, siempre bindeado a 127.0.0.1 (ver docker-compose.yml).
LOLVAULT_PORT=3025
# Web Push opcional. Generar una vez con `npm run vapid:generate` y no rotar el par.
LOLVAULT_VAPID_PUBLIC_KEY=
LOLVAULT_VAPID_PRIVATE_KEY=
LOLVAULT_VAPID_SUBJECT=
# Solo si `id jpft` no da 1000:
#LOLVAULT_UID=1000
#LOLVAULT_GID=1000

# ── Solo desarrollo (.env.local en la Mac) ──
DATABASE_PATH=./data/lolvault.db
# Login sin Cloudflare + selector de usuario. NUNCA en el server: con NODE_ENV=production la app no arranca.
LOLVAULT_DEV_USER_EMAIL=
# Ventana móvil en días para Draft; también acepta un parche exacto, por ejemplo 16.18.
LOLALYTICS_PATCH_WINDOW=30
